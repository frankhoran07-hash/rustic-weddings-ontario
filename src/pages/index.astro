---
export const prerender = true;
import VenueExplorer from '../components/VenueExplorer.jsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rustic Weddings Ontario | Barn, Farm & Country Venues</title>
    <meta
      name="description"
      content="Find the best rustic wedding venues across Ontario. Barns, farms, historic mills, and proximity search."
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </head>
  <body style="margin: 0; padding: 0; background-color: #fafaf9;">
    <!-- Top Navigation -->
    <header style="height: 60px; background-color: #ffffff; border-bottom: 1px solid #e7e5e4; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; font-family: system-ui, sans-serif;">
      <a href="/" style="text-decoration: none; font-weight: 700; color: #1c1917; font-size: 16px;">
        🌿 Rustic Weddings Ontario
      </a>
      <a href="/venues" style="text-decoration: none; color: #78716c; font-size: 14px;">
        Venues
      </a>
    </header>

    <!-- Combined Explorer (Hero, Filters, Leaflet Map, Venue Cards) -->
    <VenueExplorer client:only="react" initialVenues={[]} />

    <!-- Footer -->
    <footer style="margin-top: 60px; padding: 32px 20px; text-align: center; border-top: 1px solid #e7e5e4; font-size: 13px; color: #a8a29e; font-family: system-ui, sans-serif;">
      &copy; {new Date().getFullYear()} Rustic Weddings Ontario. All rights reserved.
    </footer>
  </body>
</html>