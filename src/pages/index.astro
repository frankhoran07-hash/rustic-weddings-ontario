---
export const prerender = false;

import { createClient } from '@supabase/supabase-js';
import VenueCard from '../components/venue-card';
import VenueExplorer from '../components/VenueExplorer.jsx';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || process.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || process.env.PUBLIC_SUPABASE_ANON_KEY;

let featuredVenues = [];

if (supabaseUrl && supabaseKey) {
  const supabase = createClient(supabaseUrl, supabaseKey);
  const { data, error } = await supabase
    .from('venues')
    .select('id, name, slug, city, region, image_url, capacity, starting_price, latitude, longitude')
    .order('name', { ascending: true });

  if (!error && data) {
    featuredVenues = data;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rustic Weddings Ontario | Barn, Farm & Country Venues</title>
    <meta
      name="description"
      content="Find the best rustic wedding venues across Ontario. Discover barns, historic estates, winery settings, and proximity-based search."
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 font-sans antialiased">
    <!-- Navigation -->
    <header class="border-b border-stone-200 bg-white/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight text-amber-950 hover:text-amber-900 transition">
          🌿 Rustic Weddings Ontario
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium text-stone-600">
          <a href="#search" class="hover:text-amber-950 transition">Find Near Me</a>
          <a href="#featured" class="hover:text-amber-950 transition">Featured Venues</a>
          <a href="/contact" class="hover:text-amber-950 transition">Contact</a>
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
      <!-- Hero Section -->
      <section class="text-center py-12 sm:py-16 bg-gradient-to-b from-amber-100/50 to-transparent rounded-3xl p-8 border border-amber-200/40">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-stone-900 max-w-3xl mx-auto leading-tight">
          Discover Ontario's Most Charming Rustic Wedding Venues
        </h1>
        <p class="mt-4 text-lg text-stone-600 max-w-2xl mx-auto">
          From historic timber-frame barns in the Ottawa Valley to vineyard estates in Niagara and lakeside retreats in Muskoka.
        </p>
      </section>

      <!-- Proximity Search & Map Explorer Section -->
      <section id="search" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900">
            Interactive Venue Map & Proximity Search
          </h2>
          <p class="text-stone-600 mt-1">
            Enter your town or city to calculate driving distances and view nearby venues on the map.
          </p>
        </div>
        <div class="bg-white p-4 sm:p-6 rounded-2xl border border-stone-200 shadow-sm">
          <VenueExplorer client:only="react" initialVenues={featuredVenues} />
        </div>
      </section>

      <!-- Featured Directory Cards Grid -->
      <section id="featured" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900">
            Featured Venues
          </h2>
          <p class="text-stone-600 mt-1">
            Showing {featuredVenues.length} rustic locations across Ontario.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredVenues.map((venue) => (
            <VenueCard key={venue.id || venue.slug} venue={venue} />
          ))}
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-stone-900 text-stone-400 mt-20 border-t border-stone-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex flex-col sm:flex-row justify-between items-center gap-6 text-sm">
        <p>© {new Date().getFullYear()} Rustic Weddings Ontario. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a>
          <a href="/terms" class="hover:text-white transition">Terms of Service</a>
          <a href="/contact" class="hover:text-white transition">Contact Us</a>
        </div>
      </div>
    </footer>
  </body>
</html>