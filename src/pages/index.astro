---
export const prerender = false;

import { createClient } from '@supabase/supabase-js';
import VenueExplorer from '../components/VenueExplorer.jsx';

const env = Astro.locals?.runtime?.env || {};
const supabaseUrl = 
  import.meta.env.PUBLIC_SUPABASE_URL || 
  process.env.PUBLIC_SUPABASE_URL || 
  env.PUBLIC_SUPABASE_URL;

const supabaseKey = 
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 
  process.env.PUBLIC_SUPABASE_ANON_KEY || 
  env.PUBLIC_SUPABASE_ANON_KEY;

let venues = [];

if (supabaseUrl && supabaseKey) {
  try {
    const supabase = createClient(supabaseUrl, supabaseKey);
    const { data, error } = await supabase
      .from('venues')
      .select('id, name, slug, city, region, image_url, capacity, starting_price, latitude, longitude')
      .order('name', { ascending: true });

    if (!error && data) {
      venues = data;
    }
  } catch (err) {
    console.error('SSR Supabase fetch error:', err);
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rustic Weddings Ontario | Barn, Farm & Country Venues</title>
    <meta
      name="description"
      content="Find the best rustic wedding venues across Ontario. Barns, farms, historic mills, and proximity search."
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </head>
  <body style="margin: 0; padding: 0; background-color: #fafaf9;">
    <header style="height: 60px; background-color: #ffffff; border-bottom: 1px solid #e7e5e4; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; font-family: system-ui, sans-serif;">
      <a href="/" style="text-decoration: none; font-weight: 700; color: #1c1917; font-size: 16px;">
        🌿 Rustic Weddings Ontario
      </a>
      <a href="/venues" style="text-decoration: none; color: #78716c; font-size: 14px;">
        Venues
      </a>
    </header>

    <VenueExplorer client:only="react" initialVenues={venues} />

    <footer style="margin-top: 60px; padding: 32px 20px; text-align: center; border-top: 1px solid #e7e5e4; font-size: 13px; color: #a8a29e; font-family: system-ui, sans-serif;">
      &copy; {new Date().getFullYear()} Rustic Weddings Ontario. All rights reserved.
    </footer>
  </body>
</html>